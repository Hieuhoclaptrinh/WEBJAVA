<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.studentrent</groupId>
    <artifactId>student-rent-management</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Student Rent Management</name>
    <description>Ung dung web quan ly nha tro sinh vien - Java Servlet + JSP + MySQL</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Runtime / API versions -->
        <servlet.version>6.0.0</servlet.version>
        <jstl.api.version>3.0.0</jstl.api.version>
        <jstl.impl.version>3.0.1</jstl.impl.version>
        <mysql.version>8.4.0</mysql.version>
        <hikaricp.version>5.1.0</hikaricp.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <gson.version>2.11.0</gson.version>
        <itext.version>5.5.13</itext.version>
        <fileupload.version>2.0.0-M5</fileupload.version>
        <slf4j.version>2.0.13</slf4j.version>

        <!-- Plugin versions -->
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <war.plugin.version>3.4.0</war.plugin.version>
        <exec.plugin.version>3.6.3</exec.plugin.version>
        <cargo.plugin.version>1.10.28</cargo.plugin.version>
        <tomcat.version>10.1.57</tomcat.version>

        <!-- Plugin cua lifecycle mac dinh. Neu khong ghim, version cua chung do
             ban Maven tren tung may quyet dinh (Maven 3.9 va 4.x binh mac dinh
             khac nhau) => hai may build ra ket qua khac nhau. Ghim de "mvn clean
             package" tren Windows va macOS chay dung cung mot bo plugin.        -->
        <clean.plugin.version>3.3.2</clean.plugin.version>
        <resources.plugin.version>3.3.1</resources.plugin.version>
        <surefire.plugin.version>3.2.5</surefire.plugin.version>
        <install.plugin.version>3.1.2</install.plugin.version>
        <deploy.plugin.version>3.1.2</deploy.plugin.version>
    </properties>

    <dependencies>

        <!-- ============ Jakarta Servlet 6.0 (Tomcat 10.1 cung cap san) ============ -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ============ JSTL 3.0 ============
             Tomcat 10 KHONG dong goi JSTL => impl phai duoc dong vao WEB-INF/lib
             (scope compile, khong dung provided).
             Taglib URI moi: jakarta.tags.core / jakarta.tags.fmt          -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>${jstl.api.version}</version>
            <exclusions>
                <!-- jstl-api keo theo jakarta.el-api, nhung Tomcat 10.1 da co san
                     EL API + impl. De lot vao WEB-INF/lib thi chi la rac (Tomcat
                     uu tien class cua container cho package jakarta.*). -->
                <exclusion>
                    <groupId>jakarta.el</groupId>
                    <artifactId>jakarta.el-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>${jstl.impl.version}</version>
        </dependency>

        <!-- ============ MySQL 8 + HikariCP ============ -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>

        <!-- HikariCP log qua SLF4J; khong co binding thi chi thay canh bao NOP -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- ============ BCrypt - ma hoa mat khau ============ -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

        <!-- ============ Gson - JSON / AJAX ============ -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- ============ iText 5 - xuat PDF ============
             Luu y license: iText 5 la AGPL. Dung cho do an/hoc tap thi OK,
             dung thuong mai can mua license hoac chuyen sang OpenPDF.       -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <!-- ============ Commons FileUpload - upload anh ============
             commons-fileupload 1.x chi ho tro javax.servlet => KHONG dung duoc
             tren Tomcat 10. Ban cho Jakarta Servlet 6 la artifact duoi day.
             (Keo theo commons-fileupload2-core + commons-io)                -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-fileupload2-jakarta-servlet6</artifactId>
            <version>${fileupload.version}</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>student-rent</finalName>

        <!-- Ghim version cho cac plugin lifecycle mac dinh (clean / resources /
             surefire / install / deploy). Chung khong xuat hien trong <plugins>
             nhung van chay moi lan "mvn clean package"; khong ghim thi Maven tu
             chon version theo super-POM cua rieng may do.                       -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${clean.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${resources.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${install.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${deploy.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${war.plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Tien ich chay class main tu CLI, vd sinh BCrypt hash:
                 mvn -q compile exec:java -Dexec.mainClass=com.studentrent.util.PasswordUtil -Dexec.args="matkhau" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
            </plugin>

            <!-- ============ Chay Tomcat ngay tu Maven (khong can cai Tomcat) ============
                 mvn package cargo:run  -> tu tai Tomcat 10.1 ve, deploy WAR, chay tai
                                           http://localhost:8080/student-rent/

                 PHAI co "package" o truoc. Cargo deploy file WAR trong target/,
                 khong tu build no; goi "mvn cargo:run" tran tro tren mot ban
                 clone moi (chua co target/) se BUILD FAILURE vi khong tim thay WAR.

                 Chay giong het nhau tren Windows / macOS / Linux.
                 Debug: xem task "Tomcat: debug" trong .vscode/tasks.json          -->
            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <version>${cargo.plugin.version}</version>
                <configuration>
                    <container>
                        <containerId>tomcat10x</containerId>
                        <!-- Tai Tomcat tu Maven Central (nhanh, vinh vien, cache trong ~/.m2).
                             KHONG dung zipUrlInstaller voi archive.apache.org - server do
                             rat cham va hay timeout. -->
                        <artifactInstaller>
                            <groupId>org.apache.tomcat</groupId>
                            <artifactId>tomcat</artifactId>
                            <version>${tomcat.version}</version>
                        </artifactInstaller>
                    </container>
                    <configuration>
                        <properties>
                            <cargo.servlet.port>8080</cargo.servlet.port>
                        </properties>
                    </configuration>
                    <deployables>
                        <deployable>
                            <groupId>com.studentrent</groupId>
                            <artifactId>student-rent-management</artifactId>
                            <type>war</type>
                            <properties>
                                <context>/student-rent</context>
                            </properties>
                        </deployable>
                    </deployables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
